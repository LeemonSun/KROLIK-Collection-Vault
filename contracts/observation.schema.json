{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "scope",
    "timestamp_ms",
    "application_id",
    "elements",
    "visual",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "enum": [
        "selected_window",
        "selected_region",
        "desktop"
      ]
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "application_id": {
      "type": "string"
    },
    "elements": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "bounds_px",
          "text",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "enum": [
              "accessibility",
              "ocr",
              "vision"
            ]
          },
          "bounds_px": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "visual": {
      "type": [
        "object",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "capture_id",
        "frame_saved",
        "remote_sent"
      ],
      "properties": {
        "capture_id": {
          "type": "string"
        },
        "frame_saved": {
          "const": false
        },
        "remote_sent": {
          "const": false
        }
      }
    }
  }
}
