{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "version",
    "source",
    "sha256",
    "license",
    "artifact",
    "review_status",
    "languages"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "license": {
      "type": "string"
    },
    "artifact": {
      "type": "string"
    },
    "review_status": {
      "enum": [
        "approved",
        "rejected",
        "pending"
      ]
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

