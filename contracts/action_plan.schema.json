{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "observation_id",
    "intent",
    "status",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observation_id": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposal",
        "needs_clarification",
        "unsupported"
      ]
    },
    "steps": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "tool",
          "arguments",
          "evidence_element_ids",
          "expected_result"
        ],
        "additionalProperties": false,
        "properties": {
          "tool": {
            "type": "string"
          },
          "arguments": {
            "type": "object"
          },
          "evidence_element_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_result": {
            "type": "string"
          }
        }
      }
    }
  }
}
