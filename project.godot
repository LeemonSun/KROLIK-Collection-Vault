; Engine 4.7.2; no third-party addon or model is bundled in this scaffold.
config_version=5

[application]
config/name="Companion Foundation"
config/version="0.1.0-foundation"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/foundation.svg"

[autoload]
App="*res://src/app.gd"

[display]
window/size/viewport_width=1120
window/size/viewport_height=760
window/size/window_width_override=1120
window/size/window_height_override=760
window/stretch/mode="canvas_items"
window/size/min_width=850
window/size/min_height=600

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.071, 0.094, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
driver/enable_input=false

