; Engine 4.7.2; no third-party addon or model is bundled in this scaffold.
config_version=5

[application]
config/name="Companion Foundation"
config/version="0.24.0-desktop-preview"
run/main_scene="res://scenes/bootstrap.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/foundation.svg"

[autoload]
App="*res://src/app.gd"

[display]
window/size/viewport_width=330
window/size/viewport_height=500
window/size/window_width_override=330
window/size/window_height_override=500
window/stretch/mode="disabled"
window/vsync/vsync_mode=0
window/per_pixel_transparency/allowed=true
window/subwindows/embed_subwindows=false
window/size/min_width=1
window/size/min_height=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08235, 0.0902, 0.09804, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
driver/enable_input=true
general/text_to_speech=true

