@echo off
setlocal
set "COMPANION_ROOT=%~dp0"
echo Preparing Companion Preview.
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop';$root=$env:COMPANION_ROOT; $m=Get-Content -LiteralPath (Join-Path $root 'downloads/preview-manifest.json') -Raw | ConvertFrom-Json; $dir=Join-Path $root 'build/windows-preview';$target=Join-Path $dir 'Companion_Preview';$exe=Join-Path $target 'Companion.exe';$pack=Join-Path $target 'Companion.pck'; $ready=(Test-Path -LiteralPath $exe) -and (Test-Path -LiteralPath $pack) -and ((Get-FileHash -LiteralPath $exe -Algorithm SHA256).Hash -eq $m.exe_sha256) -and $m.pack_sha256 -and ((Get-FileHash -LiteralPath $pack -Algorithm SHA256).Hash -eq $m.pack_sha256); if(-not $ready){ foreach($p in $m.packages){ $dest=Join-Path $root $p.output; if(-not (Test-Path -LiteralPath $dest) -or (Get-FileHash -LiteralPath $dest -Algorithm SHA256).Hash -ne $p.sha256){ [IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($dest)) | Out-Null;$output=[IO.File]::Open($dest,[IO.FileMode]::Create); try{foreach($part in $p.parts){$inputStream=[IO.File]::OpenRead((Join-Path $root $part));try{$inputStream.CopyTo($output)}finally{$inputStream.Dispose()}}}finally{$output.Dispose()}; if((Get-FileHash -LiteralPath $dest -Algorithm SHA256).Hash -ne $p.sha256){throw 'Package integrity check failed.'}; }; }; Expand-Archive -LiteralPath (Join-Path $root 'build/Companion_Preview_Windows_v0.3.zip') -DestinationPath $dir -Force; Expand-Archive -LiteralPath (Join-Path $root 'build/Companion_Fix_0.3.1.zip') -DestinationPath $target -Force; $env:COMPANION_PATCH_ROOT=$target; & ([scriptblock]::Create((Get-Content -LiteralPath (Join-Path $target 'fix031/Apply-Fix.ps1') -Raw)));if(-not $?){throw '0.3.1 base update failed'}; Expand-Archive -LiteralPath (Join-Path $root 'build/Companion_Fix_0.3.2.zip') -DestinationPath $target -Force; & ([scriptblock]::Create((Get-Content -LiteralPath (Join-Path $target 'fix032/Apply-Update.ps1') -Raw)));if(-not $?){throw '0.3.2 content update failed'}; Expand-Archive -LiteralPath (Join-Path $root 'build/Companion_Fix_0.3.3.zip') -DestinationPath $target -Force; & ([scriptblock]::Create((Get-Content -LiteralPath (Join-Path $target 'fix033/Apply-Update.ps1') -Raw)));if(-not $?){throw '0.3.3 visual update failed'}; }; Start-Process -FilePath $exe;"
if errorlevel 1 (
 echo Startup failed. Keep the error above.
 pause
 exit /b 1
)
endlocal
