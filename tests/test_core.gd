extends SceneTree
const Router = preload("res://src/core/router.gd")
const Store = preload("res://src/core/store.gd")
const Policy = preload("res://src/core/tool_policy.gd")
const Profiles = preload("res://src/core/profile.gd")
const State = preload("res://src/core/state_machine.gd")
const L10n = preload("res://src/core/localization.gd")
const Buffer = preload("res://src/perception/observation_buffer.gd")
const Gate = preload("res://src/core/resource_gate.gd")
var count = 0
var failures = []

func _initialize():
	_run.call_deferred()

func check(condition, message):
	count += 1
	if not condition:
		failures.append(message)
		push_error(message)

func _run():
	var router = Router.new()
	check(router.route("/таймер 30").args.seconds == 30, "Russian timer")
	check(router.route("/timer 1").args.seconds == 1, "English timer")
	check(router.route("/计时 86400").args.seconds == 86400, "Chinese timer")
	for input in ["/timer 0","/timer -1","/timer 86401","/timer 1.5","/timer NaN","/timer 999999999999999999999999999999","/note","/unknown"]:
		check(router.route(input).kind == "invalid", "Invalid command rejected: " + input)
	check(router.route("x".repeat(2049)).kind == "invalid", "Oversize message")
	check(router.route("   ").kind == "invalid", "Blank input")
	check(router.route("/笔记 你好").args.text == "你好", "Chinese note")
	check(router.route("help me understand this screen").kind == "chat", "General task stays generic")
	var policy = Policy.new()
	check(policy.evaluate("notes.add").allowed, "Ordinary tool allowed")
	check(not policy.evaluate("notes.clear").allowed, "Destructive tool needs decision")
	check(policy.evaluate("notes.clear", true).allowed, "Explicit decision allowed")
	check(not policy.evaluate("shell.exec", true).allowed, "Unknown tool denied")
	check(not policy.evaluate("files.delete", true).allowed, "Unimplemented tool denied even after confirmation")
	var state = State.new()
	check(not state.transition("speaking"), "Impossible state edge rejected")
	check(state.transition("thinking"), "Thinking begins")
	check(not state.transition("executing"), "No parallel effects while thinking")
	state.reset()
	check(state.current == "idle", "Cancel resets state")
	var profiles = Profiles.new()
	check(profiles.select("auto", 0) == "lite", "Unknown hardware conservative")
	check(profiles.select("auto", 8 * 1024 * 1024 * 1024) == "lite", "8 GB lite")
	check(profiles.select("auto", 16 * 1024 * 1024 * 1024) == "balanced", "16 GB balanced")
	check(profiles.select("auto", 32 * 1024 * 1024 * 1024) == "quality", "32 GB quality")
	check(profiles.select("garbage", 0) == "lite", "Unknown profile safe fallback")
	var l10n = L10n.new()
	for code in ["ru","en","zh-Hans"]:
		check(l10n.set_locale(code), "Locale " + code)
		check(l10n.text("timer_done", {"seconds":42}).contains("42"), "Locale interpolation " + code)
	check(not l10n.set_locale("../../etc/passwd"), "Locale traversal rejected")
	var path = "user://test-notes-%s.json" % Time.get_ticks_usec()
	var store = Store.new(path)
	check(store.load_state(), "New store")
	check(store.add_note("Русский / 中文 / English"), "Unicode atomic persistence")
	var loaded = Store.new(path)
	check(loaded.load_state() and loaded.data.notes[0].text == "Русский / 中文 / English", "Unicode round trip")
	check(loaded.clear_notes(), "Clear notes")
	check(not loaded.add_note(""), "Empty note denied")
	check(not loaded.add_note("x".repeat(2049)), "Long note denied")
	var f = FileAccess.open(path, FileAccess.WRITE)
	f.store_string("{broken")
	f.close()
	var broken = Store.new(path)
	check(not broken.load_state(), "Corruption detected")
	check(not broken.add_note("cannot overwrite corrupt data"), "Corrupt store refuses mutation")
	check(FileAccess.get_file_as_string(path) == "{broken", "Corrupt original retained")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
	var buffer = Buffer.new()
	var observation = {"schema_version":1,"timestamp_ms":1000,"application_id":"any.application","scope":"selected_window"}
	check(not buffer.accept(observation).ok, "No capture without consent")
	check(buffer.grant_scope("selected_window"), "Scope granted")
	check(buffer.accept(observation).ok, "Generic observation accepted")
	check(not buffer.accept(observation).ok, "Stale observation denied")
	observation.timestamp_ms = 1500
	check(buffer.accept(observation).reason == "throttled", "Heavy perception throttled")
	observation.timestamp_ms = 3000
	check(buffer.accept(observation).ok, "Fresh observation accepted")
	check(not buffer.context_at(14000).available, "Stale context not exposed")
	buffer.revoke()
	check(not buffer.context_at(3001).available, "Revoke clears context")
	var gate = Gate.new()
	check(gate.acquire("vision1","vision"), "Vision admitted")
	check(not gate.acquire("chat1","chat"), "Shared heavy budget blocks chat")
	gate.release("vision1")
	check(gate.acquire("chat1","chat"), "Budget released")
	gate.cancel_all()
	check(gate.active.is_empty(), "Cancel clears admissions")
	var app = root.get_node("App")
	check(app.provider_name == "unconfigured", "Default has no network provider")
	var old_store = app.store
	app.store = Store.new("user://integration-%s.json" % Time.get_ticks_usec())
	app.persistence_ready = true
	app.submit("/note integration")
	check(app.store.data.notes.size() == 1, "Application executes deterministic note")
	app.submit("hello")
	check(app.state.current == "idle", "Missing model exits busy state")
	check(app.messages.back().text == app.t("model_missing"), "Missing model honestly reported")
	app.state.transition("thinking")
	app.pending_user_text = "original user question"
	app.add_message("assistant", "a timer ended meanwhile")
	app._on_answer("answer to original question")
	check(app.session_turns[-2].content == "original user question", "Async notices cannot replace model request context")
	app.session_turns.clear()
	app.set_paused(true)
	app.submit("/note should not be saved")
	check(app.store.data.notes.size() == 1, "Pause prevents new effects")
	app.set_paused(false)
	app.submit("/timer 1")
	check(app.timers.size() == 1, "Timer registered")
	await create_timer(1.1).timeout
	check(app.timers.is_empty(), "Timer completed and released")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(app.store.path))
	app.store = old_store
	print("CORE_TESTS: %s checks, %s failures" % [count,failures.size()])
	quit(0 if failures.is_empty() else 1)

