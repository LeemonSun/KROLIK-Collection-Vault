extends RefCounted
## Effects are parsed from the user's message, never generated by the LLM.
func route(text):
	var read_command=preload("res://src/core/window_reader.gd").route(text)
	if not read_command.is_empty():return read_command
	var normalized = text.to_lower().strip_edges()
	if normalized in ["редактировать файл","измени файл","edit a file","edit selected file","编辑文件"]:return {"kind":"tool","tool":"files.edit_selected","args":{}}
	if normalized in ["мои факты","покажи факты","my facts","show facts","我的事实"]:return {"kind":"tool","tool":"facts.list","args":{}}
	var fact=RegEx.new();fact.compile("^(?:запомни факт|remember fact|记住事实)\\s+([^:：]{1,96})[:：]\\s*(.+)$")
	var fact_hit=fact.search(normalized)
	if fact_hit:return {"kind":"tool","tool":"facts.set","args":{"key":text.strip_edges().substr(fact_hit.get_start(1),fact_hit.get_end(1)-fact_hit.get_start(1)),"value":text.strip_edges().substr(fact_hit.get_start(2))}}
	fact.compile("^(?:забудь факт|forget fact|忘记事实)\\s+(.+)$");fact_hit=fact.search(normalized)
	if fact_hit:return {"kind":"tool","tool":"facts.forget","args":{"key":fact_hit.get_string(1)}}
	if normalized in ["который час", "сколько времени", "what time is it", "现在几点", "现在几点？"]:return {"kind":"tool","tool":"clock.now","args":{"city":"local"}}
	if normalized in ["мои напоминания","напоминания","show reminders","my reminders","查看提醒","/reminders"]:return {"kind":"tool","tool":"reminders.list","args":{}}
	if normalized in ["пройдись","прогуляйся","walk around","走一走"]:return {"kind":"tool","tool":"companion.walk","args":{}}
	if normalized in ["посмотри на экран","что на экране","что на экране?","опиши экран","look at my screen","describe my screen","what is on my screen","看看屏幕","描述屏幕","/screen"]:return {"kind":"tool","tool":"screen.describe","args":{}}
	if normalized in ["посмотри элементы окна","inspect window"]:return {"kind":"tool","tool":"access.inspect","args":{}}
	var rx = RegEx.new()
	rx.compile("^(?:нажми(?: (?:на|кнопку|вкладку))?|выбери вкладку|click|select tab|点击|选择标签)\\s+[«\"“]?(.+?)[»\"”]?[.!?。]?$" )
	var access_hit=rx.search(text.strip_edges())
	if access_hit:return {"kind":"tool","tool":"access.invoke","args":{"name":access_hit.get_string(1)}}
	rx.compile("^(впиши|допиши|вставь|write|append|输入|追加)\\s+[«\"“]?(.+?)[»\"”]?\\s*[:：]\\s*([\\s\\S]+)$" )
	access_hit=rx.search(text.strip_edges())
	if access_hit:return {"kind":"tool","tool":"access.write","args":{"name":access_hit.get_string(2),"text":access_hit.get_string(3),"append":access_hit.get_string(1).to_lower() in ["допиши","append","追加"]}}

	rx.compile("^(?:создай(?: мне)? (?:новый )?(?:документ(?: word)?|файл word)|create (?:a )?(?:new )?(?:word )?document|创建(?:Word)?文档)(?:\\s*[:：]\\s*([\\s\\S]*))?$" )
	var word_hit=rx.search(normalized)
	if word_hit:
		var body=text.strip_edges().substr(word_hit.get_start(1)) if word_hit.get_start(1)>=0 else ""
		return {"kind":"tool","tool":"documents.create","args":{"text":body,"format":"docx"}}
	rx.compile("(?i)^(?:(?:в этом окне|помоги в окне|in this window|help in this window)(?:\\s*[:：]\\s*|\\s+)|(?:在此窗口|帮我在窗口中)[:：]?\\s*)([\\s\\S]+)$")
	var goal_hit=rx.search(text.strip_edges())
	if goal_hit:return {"kind":"tool","tool":"access.goal","args":{"goal":goal_hit.get_string(1)}}
	# This command creates a NEW file in Documents/Leemon; it never edits a focused window.
	rx.compile("^(?:создай(?: мне)? (?:в (?:блокноте|блакноте) (?:новый )?файл|(?:новый )?файл в (?:блокноте|блакноте))|create (?:a )?(?:new )?(?:text )?file in notepad|在记事本中?新建(?:文本)?文件)(?:\\s*[:：]\\s*([\\s\\S]*))?[.!?。]?$" )
	var document_hit=rx.search(normalized)
	if document_hit:
		var body=""
		if document_hit.get_start(1)>=0:body=text.strip_edges().substr(document_hit.get_start(1))
		return {"kind":"tool","tool":"documents.create","args":{"text":body}}
	rx.compile("^(?:вставь|запиши|напиши|сохрани|удали|переименуй|перемести|нажми|click|type|save|delete|rename|move|输入|保存|删除).*(?:блокнот|блакнот|браузер|вкладк|файл|документ|notepad|browser|tab|file|document|记事本|浏览器|文件)")
	if rx.search(normalized):return {"kind":"invalid","key":"desktop_edit_unavailable"}
	rx.compile("^(?:(?:скажи|покажи)(?: мне)?\\s+)?(?:сколько(?: сейчас)? времени(?: сейчас)? в|который час в|время в|what time is it in|time in)\\s+(.+?)[.!?]?$" )
	var time_hit=rx.search(normalized)
	if time_hit:return {"kind":"tool","tool":"clock.now","args":{"city":text.strip_edges().substr(time_hit.get_start(1),time_hit.get_end(1)-time_hit.get_start(1)).strip_edges()}}
	rx.compile("^(?:现在)?(.+?)(?:现在)?几点(?:了)?[？?]?$" )
	time_hit=rx.search(normalized)
	if time_hit:return {"kind":"tool","tool":"clock.now","args":{"city":text.strip_edges().substr(time_hit.get_start(1),time_hit.get_end(1)-time_hit.get_start(1)).strip_edges()}}
	rx.compile("^(?:напомни(?: мне)? через|remind me in)\\s+(\\d+)\\s+(секунд[уы]?|минут[уы]?|час[ао]?в?|дней|дня|день|seconds?|minutes?|hours?|days?)\\s*[:,]?\\s+(.+)$" )
	var reminder_hit=rx.search(normalized)
	if reminder_hit:
		var seconds=int(reminder_hit.get_string(1))
		var unit=reminder_hit.get_string(2)
		if unit.begins_with("мин") or unit.begins_with("minute"):seconds*=60
		elif unit.begins_with("час") or unit.begins_with("hour"):seconds*=3600
		elif unit.begins_with("дн") or unit=="день" or unit.begins_with("day"):seconds*=86400
		if seconds<1 or seconds>2678400:return {"kind":"invalid","key":"reminder_invalid"}
		return {"kind":"tool","tool":"reminders.add","args":{"seconds":seconds,"text":text.strip_edges().substr(reminder_hit.get_start(3))}}
	rx.compile("^(\\d+)(秒|分钟|小时|天)后提醒我(.+)$")
	reminder_hit=rx.search(normalized)
	if reminder_hit:
		var seconds=int(reminder_hit.get_string(1))*{"秒":1,"分钟":60,"小时":3600,"天":86400}[reminder_hit.get_string(2)]
		if seconds<1 or seconds>2678400:return {"kind":"invalid","key":"reminder_invalid"}
		return {"kind":"tool","tool":"reminders.add","args":{"seconds":seconds,"text":text.strip_edges().substr(reminder_hit.get_start(3))}}
	rx.compile("^/remind\\s+(\\d+)\\s+(.+)$")
	reminder_hit=rx.search(normalized)
	if reminder_hit:
		var seconds=int(reminder_hit.get_string(1))
		if seconds<1 or seconds>2678400:return {"kind":"invalid","key":"reminder_invalid"}
		return {"kind":"tool","tool":"reminders.add","args":{"seconds":seconds,"text":text.strip_edges().substr(reminder_hit.get_start(2))}}
	rx.compile("^(?:переведи (?:текст (?:из )?)?буфер(?:а)?(?: обмена)?|translate (?:the )?clipboard|翻译剪贴板)(?:\\s*(?:на|to|为)\\s*(.+))?[.!?。]?$" )
	var clipboard_hit=rx.search(normalized)
	if clipboard_hit:
		var target=clipboard_hit.get_string(1).strip_edges().rstrip(".!?。？")
		var locales={"русский":"ru","русском":"ru","russian":"ru","俄语":"ru","английский":"en","английском":"en","english":"en","英语":"en","英文":"en","китайский":"zh-Hans","китайском":"zh-Hans","chinese":"zh-Hans","中文":"zh-Hans"}
		if not target.is_empty() and not locales.has(target):return {"kind":"invalid","key":"clipboard_language"}
		return {"kind":"tool","tool":"clipboard.translate","args":{"locale":locales.get(target,"")}}
	rx.compile("^(?:(?:пожалуйста|ну|тогда|please)\\s+)?(?:(?:можешь|can you|could you)\\s+)?(?:открой|открыть|запусти|запустить|open|launch|打开|启动|/open)\\s*(?:мне\\s+)?(.+?)\\s*[.!?]?$" )
	var hit = rx.search(normalized)
	if hit:
		var target = text.strip_edges().substr(hit.get_start(1), hit.get_end(1)-hit.get_start(1)).strip_edges()
		for suffix in [", пожалуйста", " пожалуйста", " please"]:
			if target.to_lower().ends_with(suffix): target = target.left(-suffix.length()).strip_edges()
		if not target.is_empty(): return {"kind":"tool", "tool":"apps.open", "args":{"target":target}}
	rx.compile("^(?:запомни(?:,? что)?|remember(?: that)?|记住)\\s*[:：,]?\\s*(.+)$")
	hit = rx.search(normalized)
	if hit: return {"kind":"tool", "tool":"notes.add", "args":{"text":text.strip_edges().substr(hit.get_start(1))}}
	rx.compile("^(?:найди(?: в интернете)?|поищи(?: в интернете)?|search(?: for)?|搜索)\\s+(.+)$")
	hit = rx.search(normalized)
	if hit: return {"kind":"tool", "tool":"browser.search", "args":{"query":text.strip_edges().substr(hit.get_start(1))}}
	rx.compile("^(?:(?:поставь|запусти|set|start)\\s+)?(?:таймер|timer)(?:\\s+на|\\s+for)?\\s+(\\d+)\\s*(секунд[уы]?|минут[уы]?|час[ао]?в?|seconds?|minutes?|hours?)?[.!]?$" )
	hit = rx.search(normalized)
	if hit:
		var seconds = int(hit.get_string(1))
		var unit = hit.get_string(2)
		if unit.begins_with("мин") or unit.begins_with("minute"): seconds *= 60
		if unit.begins_with("час") or unit.begins_with("hour"): seconds *= 3600
		if seconds<1 or seconds>86400: return {"kind":"invalid", "key":"timer_invalid"}
		return {"kind":"tool", "tool":"timer.start", "args":{"seconds":seconds}}
	return {}
