extends RefCounted
## Effects are parsed from the user's message, never generated by the LLM.
func route(text):
	var normalized = text.to_lower().strip_edges()
	if normalized in ["который час", "сколько времени", "what time is it", "现在几点", "现在几点？"]:return {"kind":"tool","tool":"clock.now","args":{"city":"local"}}
	if normalized in ["мои напоминания","напоминания","show reminders","my reminders","查看提醒","/reminders"]:return {"kind":"tool","tool":"reminders.list","args":{}}
	if normalized in ["пройдись","прогуляйся","walk around","走一走"]:return {"kind":"tool","tool":"companion.walk","args":{}}
	var rx = RegEx.new()
	rx.compile("^(?:сколько(?: сейчас)? времени(?: сейчас)? в|который час в|время в|what time is it in|time in)\\s+(.+?)[.!?]?$" )
	var time_hit=rx.search(normalized)
	if time_hit:return {"kind":"tool","tool":"clock.now","args":{"city":time_hit.get_string(1).strip_edges()}}
	rx.compile("^(?:现在)?(.+?)(?:现在)?几点(?:了)?[？?]?$" )
	time_hit=rx.search(normalized)
	if time_hit:return {"kind":"tool","tool":"clock.now","args":{"city":time_hit.get_string(1).strip_edges()}}
	rx.compile("^(?:напомни(?: мне)? через|remind me in)\\s+(\\d+)\\s+(секунд[уы]?|минут[уы]?|час[ао]?в?|дней|дня|день|seconds?|minutes?|hours?|days?)\\s*[:,]?\\s+(.+)$" )
	var reminder_hit=rx.search(normalized)
	if reminder_hit:
		var seconds=int(reminder_hit.get_string(1))
		var unit=reminder_hit.get_string(2)
		if unit.begins_with("мин") or unit.begins_with("minute"):seconds*=60
		elif unit.begins_with("час") or unit.begins_with("hour"):seconds*=3600
		elif unit.begins_with("дн") or unit=="день" or unit.begins_with("day"):seconds*=86400
		if seconds<1 or seconds>2678400:return {"kind":"invalid","key":"reminder_invalid"}
		return {"kind":"tool","tool":"reminders.add","args":{"seconds":seconds,"text":text.strip_edges().substr(reminder_hit.get_start(3))}}
	rx.compile("^(\\d+)(秒|分钟|小时|天)后提醒我(.+)$")
	reminder_hit=rx.search(normalized)
	if reminder_hit:
		var seconds=int(reminder_hit.get_string(1))*{"秒":1,"分钟":60,"小时":3600,"天":86400}[reminder_hit.get_string(2)]
		if seconds<1 or seconds>2678400:return {"kind":"invalid","key":"reminder_invalid"}
		return {"kind":"tool","tool":"reminders.add","args":{"seconds":seconds,"text":text.strip_edges().substr(reminder_hit.get_start(3))}}
	rx.compile("^/remind\\s+(\\d+)\\s+(.+)$")
	reminder_hit=rx.search(normalized)
	if reminder_hit:
		var seconds=int(reminder_hit.get_string(1))
		if seconds<1 or seconds>2678400:return {"kind":"invalid","key":"reminder_invalid"}
		return {"kind":"tool","tool":"reminders.add","args":{"seconds":seconds,"text":text.strip_edges().substr(reminder_hit.get_start(2))}}
	rx.compile("^(?:переведи (?:текст (?:из )?)?буфер(?:а)?(?: обмена)?|translate (?:the )?clipboard|翻译剪贴板)(?:\\s*(?:на|to|为)\\s*(.+))?[.!?。]?$" )
	var clipboard_hit=rx.search(normalized)
	if clipboard_hit:
		var target=clipboard_hit.get_string(1).strip_edges()
		var locales={"русский":"ru","русском":"ru","russian":"ru","俄语":"ru","английский":"en","английском":"en","english":"en","英语":"en","英文":"en","китайский":"zh-Hans","китайском":"zh-Hans","chinese":"zh-Hans","中文":"zh-Hans"}
		if not target.is_empty() and not locales.has(target):return {"kind":"invalid","key":"clipboard_language"}
		return {"kind":"tool","tool":"clipboard.translate","args":{"locale":locales.get(target,"")}}
	rx.compile("^(?:(?:пожалуйста|ну|тогда|please)\\s+)?(?:(?:можешь|can you|could you)\\s+)?(?:открой|открыть|запусти|запустить|open|launch|打开|启动|/open)\\s*(?:мне\\s+)?(.+?)\\s*[.!?]?$" )
	var hit = rx.search(normalized)
	if hit:
		var target = text.strip_edges().substr(hit.get_start(1), hit.get_end(1)-hit.get_start(1)).strip_edges()
		for suffix in [", пожалуйста", " пожалуйста", " please"]:
			if target.to_lower().ends_with(suffix): target = target.left(-suffix.length()).strip_edges()
		if not target.is_empty(): return {"kind":"tool", "tool":"apps.open", "args":{"target":target}}
	rx.compile("^(?:запомни(?:,? что)?|remember(?: that)?|记住)\\s*[:：,]?\\s*(.+)$")
	hit = rx.search(normalized)
	if hit: return {"kind":"tool", "tool":"notes.add", "args":{"text":text.strip_edges().substr(hit.get_start(1))}}
	rx.compile("^(?:найди(?: в интернете)?|поищи(?: в интернете)?|search(?: for)?|搜索)\\s+(.+)$")
	hit = rx.search(normalized)
	if hit: return {"kind":"tool", "tool":"browser.search", "args":{"query":text.strip_edges().substr(hit.get_start(1))}}
	rx.compile("^(?:(?:поставь|запусти|set|start)\\s+)?(?:таймер|timer)(?:\\s+на|\\s+for)?\\s+(\\d+)\\s*(секунд[уы]?|минут[уы]?|час[ао]?в?|seconds?|minutes?|hours?)?[.!]?$" )
	hit = rx.search(normalized)
	if hit:
		var seconds = int(hit.get_string(1))
		var unit = hit.get_string(2)
		if unit.begins_with("мин") or unit.begins_with("minute"): seconds *= 60
		if unit.begins_with("час") or unit.begins_with("hour"): seconds *= 3600
		if seconds<1 or seconds>86400: return {"kind":"invalid", "key":"timer_invalid"}
		return {"kind":"tool", "tool":"timer.start", "args":{"seconds":seconds}}
	return {}
